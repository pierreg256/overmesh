{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmesh.io/schemas/performance-result-v1.json",
  "title": "Overmesh live performance campaign",
  "type": "object",
  "required": [
    "apiVersion",
    "campaign",
    "contract",
    "toolVersions",
    "cases",
    "comparisons",
    "historicalComparison",
    "generatedAt",
    "redaction"
  ],
  "properties": {
    "apiVersion": {
      "const": "performance.overmesh.io/v1"
    },
    "campaign": {
      "type": "object",
      "required": [
        "runId",
        "startedAt",
        "finishedAt",
        "commit",
        "projectVersion",
        "ringVersion",
        "ringHash",
        "deployment",
        "environment",
        "isolatedEnvironment"
      ]
    },
    "contract": {
      "type": "object",
      "required": ["id", "sha256", "schemaVersion"]
    },
    "toolVersions": {
      "type": "object",
      "required": [
        "python",
        "azureIdentity",
        "azureStorageBlob",
        "azureCli",
        "logAnalyticsExtension"
      ]
    },
    "campaignTelemetry": {
      "type": "object",
      "required": ["containerApp"]
    },
    "resolution": {
      "type": "object",
      "required": [
        "readP50SpreadRatioMax",
        "writeP50SpreadRatioMax",
        "worstCase"
      ],
      "properties": {
        "readP50SpreadRatioMax": {
          "type": "number",
          "minimum": 1
        },
        "writeP50SpreadRatioMax": {
          "type": "number",
          "minimum": 1
        },
        "worstCase": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "operation",
          "payload",
          "concurrency",
          "startedAt",
          "finishedAt",
          "iterations",
          "metrics"
        ],
        "properties": {
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "repeat",
                "startedAt",
                "finishedAt",
                "iterations",
                "metrics"
              ]
            }
          },
          "repeatability": {
            "type": "object",
            "required": [
              "runs",
              "p50MsPerRun",
              "p50SpreadRatio",
              "p50Classification"
            ],
            "properties": {
              "runs": {
                "type": "integer",
                "minimum": 1
              },
              "p50MsPerRun": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "p50SpreadRatio": {
                "type": "number",
                "minimum": 1
              },
              "requestsPerOperationPerRun": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "p50Classification": {
                "enum": ["blocking", "signal"]
              }
            },
            "additionalProperties": false
          },
          "placementCoverage": {
            "type": "object",
            "required": [
              "distinctPaths",
              "distinctPlacementPairs",
              "byBackend"
            ],
            "properties": {
              "distinctPaths": {
                "type": "integer",
                "minimum": 1
              },
              "distinctPlacementPairs": {
                "type": "integer",
                "minimum": 1
              },
              "byBackend": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case",
          "gatewayToDirectLatencyRatio",
          "gatewayToDirectThroughputRatio"
        ]
      }
    },
    "generatedAt": {
      "type": "string"
    },
    "redaction": {
      "type": "object",
      "required": [
        "apiVersion",
        "algorithm",
        "canonicalForm",
        "rawBundleSha256"
      ]
    },
    "historicalComparison": {
      "type": "object",
      "required": [
        "status",
        "apiVersion",
        "contractSha256",
        "current"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "schemaVersion": {
                "const": 4
              }
            },
            "required": ["schemaVersion"]
          }
        }
      },
      "then": {
        "required": ["resolution"],
        "properties": {
          "campaign": {
            "required": ["releaseTag"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
