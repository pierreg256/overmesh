{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmesh.io/schemas/performance-result-v1.json",
  "title": "Overmesh live performance campaign",
  "type": "object",
  "required": [
    "apiVersion",
    "campaign",
    "contract",
    "toolVersions",
    "cases",
    "comparisons",
    "historicalComparison",
    "generatedAt",
    "redaction"
  ],
  "properties": {
    "apiVersion": {
      "const": "performance.overmesh.io/v1"
    },
    "campaign": {
      "type": "object",
      "required": [
        "runId",
        "startedAt",
        "finishedAt",
        "commit",
        "projectVersion",
        "ringVersion",
        "ringHash",
        "deployment",
        "environment",
        "isolatedEnvironment"
      ],
      "properties": {
        "fixtureSetup": {
          "type": "object",
          "required": [
            "startedAt",
            "finishedAt",
            "wallSeconds",
            "fixtures",
            "backendRequests"
          ]
        },
        "clientExecution": {
          "type": "object",
          "required": [
            "wallSecondsExcludingFixtures",
            "budgetSeconds",
            "status"
          ],
          "properties": {
            "wallSecondsExcludingFixtures": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "budgetSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "const": "passed"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "contract": {
      "type": "object",
      "required": ["id", "sha256", "schemaVersion"],
      "properties": {
        "revision": {
          "const": "v5.1"
        },
        "campaignPurpose": {
          "enum": ["diagnostic-fast", "listing-confirmation"]
        },
        "baselineEligible": {
          "type": "boolean"
        },
        "clientWallTimeBudgetSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "latencyEvidence": {
          "const": "individual-samples"
        },
        "p50GatePolicy": {
          "const": "signal-only"
        },
        "confirmationPass": {
          "type": "object",
          "required": ["contract", "sha256", "trigger", "case_ids"],
          "additionalProperties": false
        },
        "targetOrderPolicy": {
          "enum": ["fixed", "counterbalanced"]
        },
        "p50ComparisonStatistic": {
          "const": "median-per-run"
        },
        "samplingBasis": {
          "type": "object",
          "required": ["artifact", "sha256", "method"],
          "additionalProperties": false
        }
      }
    },
    "toolVersions": {
      "type": "object",
      "required": [
        "python",
        "azureIdentity",
        "azureStorageBlob",
        "azureCli",
        "logAnalyticsExtension"
      ]
    },
    "campaignTelemetry": {
      "type": "object",
      "required": ["containerApp"],
      "properties": {
        "containerApp": {
          "type": "object",
          "properties": {
            "byResource": {
              "type": "object",
              "minProperties": 1,
              "patternProperties": {
                "^[0-9a-f]{16}$": {
                  "type": "object",
                  "required": ["cpuCores", "memoryBytes", "replicas"],
                  "properties": {
                    "cpuCores": {"$ref": "#/$defs/resourceMetricSummary"},
                    "memoryBytes": {"$ref": "#/$defs/resourceMetricSummary"},
                    "replicas": {"$ref": "#/$defs/resourceMetricSummary"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "replicaTransitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["resource", "at", "from", "to"],
                "properties": {
                  "resource": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "from": {
                    "type": "number",
                    "minimum": 0
                  },
                  "to": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "required": [
        "worstCase"
      ],
      "properties": {
        "readP50SpreadRatioMax": {
          "type": "number",
          "minimum": 1
        },
        "writeP50SpreadRatioMax": {
          "type": "number",
          "minimum": 1
        },
        "listingP50SpreadRatioMax": {
          "type": "number",
          "minimum": 1
        },
        "directP50SpreadRatioMax": {
          "type": "number",
          "minimum": 1
        },
        "directWorstCase": {
          "type": "string",
          "minLength": 1
        },
        "measurementScope": {
          "const": "within-campaign"
        },
        "worstCase": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "operation",
          "payload",
          "concurrency",
          "startedAt",
          "finishedAt",
          "iterations",
          "metrics"
        ],
        "properties": {
          "validity": {
            "type": "object",
            "required": [
              "status",
              "mandatory",
              "expectedRuns",
              "completedRuns",
              "failures"
            ],
            "properties": {
              "status": {
                "enum": ["valid", "invalid"]
              },
              "mandatory": {
                "const": true
              },
              "expectedRuns": {
                "type": "integer",
                "minimum": 1
              },
              "completedRuns": {
                "type": "integer",
                "minimum": 0
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "repeat",
                    "targetOrder",
                    "targetOrderPosition",
                    "startedAt",
                    "finishedAt",
                    "phase",
                    "reason",
                    "exceptionClass"
                  ],
                  "properties": {
                    "repeat": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "phase": {
                      "enum": ["setup", "warmup", "measurement"]
                    },
                    "reason": {
                      "enum": [
                        "client-operation-failed",
                        "backend-request-budget-mismatch",
                        "server-telemetry-result-mismatch"
                      ]
                    },
                    "exceptionClass": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": false
          },
          "allowedVariableBackendOperations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "ambientBackendRequests": {
            "type": "object",
            "required": ["count", "byOperationAndObjectClass"],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "byOperationAndObjectClass": {
                "type": "object",
                "required": ["validate_control_container"],
                "properties": {
                  "validate_control_container": {
                    "type": "object",
                    "required": ["system_container"],
                    "properties": {
                      "system_container": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "repeat",
                "startedAt",
                "finishedAt",
                "iterations",
                "metrics"
              ],
              "properties": {
                "targetOrder": {
                  "type": "array",
                  "prefixItems": [
                    {"enum": ["direct", "gateway"]},
                    {"enum": ["direct", "gateway"]}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "targetOrderPosition": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                },
                "latenciesMs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "backendRequestBudget": {
                  "type": "object",
                  "required": [
                    "structuralRequestsPerOperation",
                    "allowedVariableOperations",
                    "variableRequestsByOperation"
                  ],
                  "properties": {
                    "structuralRequestsPerOperation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "allowedVariableOperations": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "variableRequestsByOperation": {
                      "type": "object",
                      "minProperties": 1,
                      "propertyNames": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "repeatability": {
            "type": "object",
            "required": [
              "runs",
              "p50MsPerRun",
              "p50SpreadRatio",
              "p50Classification"
            ],
            "properties": {
              "runs": {
                "type": "integer",
                "minimum": 1
              },
              "p50MsPerRun": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "medianP50Ms": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "p50SpreadRatio": {
                "type": "number",
                "minimum": 1
              },
              "requestsPerOperationPerRun": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "requestsPerEntryScannedPerRun": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "requestsPerEntryValidatedPerRun": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "const": 4.0
                }
              },
              "p50Classification": {
                "enum": ["blocking", "signal"]
              }
            },
            "additionalProperties": false
          },
          "readPathPoolPolicy": {
            "enum": ["repeat-strided"]
          },
          "placementCoverage": {
            "type": "object",
            "required": [
              "distinctPaths",
              "distinctPlacementPairs",
              "byBackend"
            ],
            "properties": {
              "distinctPaths": {
                "type": "integer",
                "minimum": 1
              },
              "distinctPlacementPairs": {
                "type": "integer",
                "minimum": 1
              },
              "byBackend": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "additionalProperties": false
          },
          "listingBudget": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "entriesReturned",
                  "entriesScanned",
                  "backendRequests",
                  "requestsPerEntryReturned",
                  "requestsPerEntryScanned"
                ],
                "properties": {
                  "entriesReturned": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "entriesScanned": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "backendRequests": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "requestsPerEntryReturned": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "requestsPerEntryScanned": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "entriesConsidered",
                  "entriesValidated",
                  "entriesReturned",
                  "backendRequests",
                  "requestsPerEntryValidated",
                  "validationConcurrency"
                ],
                "properties": {
                  "entriesConsidered": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "entriesValidated": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "entriesReturned": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "backendRequests": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "requestsPerEntryValidated": {
                    "type": "number",
                    "const": 4.0
                  },
                  "validationConcurrency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "case",
          "gatewayToDirectLatencyRatio",
          "gatewayToDirectThroughputRatio"
        ]
      }
    },
    "generatedAt": {
      "type": "string"
    },
    "redaction": {
      "type": "object",
      "required": [
        "apiVersion",
        "algorithm",
        "canonicalForm",
        "rawBundleSha256"
      ]
    },
    "historicalComparison": {
      "type": "object",
      "required": [
        "status",
        "apiVersion",
        "contractSha256",
        "current"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cases": {
            "not": {
              "contains": {
                "properties": {
                  "validity": {
                    "properties": {
                      "status": {
                        "const": "invalid"
                      }
                    },
                    "required": ["status"]
                  }
                },
                "required": ["validity"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "comparisons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "contract": {
                "properties": {
                  "schemaVersion": {
                    "enum": [4, 5]
                  }
                },
                "required": ["schemaVersion"]
              }
            }
          },
          {
            "properties": {
              "cases": {
                "not": {
                  "contains": {
                    "properties": {
                      "validity": {
                        "properties": {
                          "status": {
                            "const": "invalid"
                          }
                        },
                        "required": ["status"]
                      }
                    },
                    "required": ["validity"]
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": ["resolution"],
        "properties": {
          "campaign": {
            "required": ["releaseTag"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "campaignPurpose": {
                "const": "listing-confirmation"
              }
            },
            "required": ["campaignPurpose"]
          }
        }
      },
      "else": {
        "properties": {
          "resolution": {
            "required": [
              "readP50SpreadRatioMax",
              "writeP50SpreadRatioMax"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "schemaVersion": {
                "const": 5
              }
            },
            "required": ["schemaVersion"]
          }
        }
      },
      "then": {
        "properties": {
          "campaign": {
            "required": ["fixtureSetup"]
          },
          "resolution": {
            "required": [
              "listingP50SpreadRatioMax",
              "directP50SpreadRatioMax",
              "directWorstCase",
              "measurementScope"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "revision": {
                "const": "v5.1"
              }
            },
            "required": ["revision"]
          }
        }
      },
      "then": {
        "properties": {
          "contract": {
            "required": [
              "campaignPurpose",
              "baselineEligible",
              "clientWallTimeBudgetSeconds",
              "latencyEvidence",
              "p50GatePolicy",
              "targetOrderPolicy",
              "p50ComparisonStatistic",
              "samplingBasis"
            ]
          },
          "campaign": {
            "required": ["clientExecution"]
          },
          "cases": {
            "items": {
              "required": ["validity"],
              "properties": {
                "runs": {
                  "items": {
                    "required": [
                      "targetOrder",
                      "targetOrderPosition",
                      "latenciesMs"
                    ]
                  }
                },
                "repeatability": {
                  "required": ["medianP50Ms"]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "resourceMetricSummary": {
      "type": "object",
      "required": ["samples", "resources", "average", "maximum"],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "average": {
          "type": ["number", "null"]
        },
        "maximum": {
          "type": ["number", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
