{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmesh.io/schemas/harness/scenario-v1.json",
  "title": "Overmesh Harness Scenario V1",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "suite",
    "environment",
    "seed",
    "initialState",
    "operations",
    "expected",
    "invariants"
  ],
  "properties": {
    "apiVersion": {
      "const": "harness.overmesh.io/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "initialState": {
      "$ref": "#/$defs/initialState"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fault"
      }
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "INVARIANT-001",
          "INVARIANT-002",
          "INVARIANT-003",
          "INVARIANT-004",
          "INVARIANT-005",
          "INVARIANT-006",
          "INVARIANT-007",
          "INVARIANT-008",
          "INVARIANT-009",
          "INVARIANT-010",
          "INVARIANT-011",
          "INVARIANT-012"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "environment": {
      "type": "object",
      "required": [
        "providers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "model",
              "azurite",
              "azure"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "initialState": {
      "type": "object",
      "required": [
        "blob"
      ],
      "properties": {
        "blob": {
          "const": "absent"
        },
        "retentionMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "replica": {
      "enum": [
        "A",
        "B"
      ]
    },
    "condition": {
      "enum": [
        "current",
        "stale",
        "any"
      ]
    },
    "byteRange": {
      "type": "object",
      "required": [
        "start",
        "endInclusive"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "endInclusive": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "action",
            "blob",
            "dataset",
            "writeId"
          ],
          "properties": {
            "action": {
              "const": "putBlob"
            },
            "blob": {
              "type": "string",
              "minLength": 1
            },
            "dataset": {
              "type": "string",
              "minLength": 1
            },
            "writeId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "blob",
            "writeId"
          ],
          "properties": {
            "action": {
              "const": "deleteBlob"
            },
            "blob": {
              "type": "string",
              "minLength": 1
            },
            "writeId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "blob"
          ],
          "properties": {
            "action": {
              "const": "head"
            },
            "blob": {
              "type": "string",
              "minLength": 1
            },
            "ifMatch": {
              "$ref": "#/$defs/condition"
            },
            "ifNoneMatch": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "blob"
          ],
          "properties": {
            "action": {
              "const": "getBlob"
            },
            "blob": {
              "type": "string",
              "minLength": 1
            },
            "ifMatch": {
              "$ref": "#/$defs/condition"
            },
            "ifNoneMatch": {
              "$ref": "#/$defs/condition"
            },
            "range": {
              "$ref": "#/$defs/byteRange"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/replicaMutation"
        },
        {
          "type": "object",
          "required": [
            "action",
            "blob"
          ],
          "properties": {
            "action": {
              "enum": [
                "observePreparedPublication",
                "observeReplicaConsistency",
                "collect",
                "reconcile"
              ]
            },
            "blob": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "blob",
            "source",
            "target"
          ],
          "properties": {
            "action": {
              "const": "attemptRepair"
            },
            "blob": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "$ref": "#/$defs/replica"
            },
            "target": {
              "$ref": "#/$defs/replica"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "blob",
            "milliseconds"
          ],
          "properties": {
            "action": {
              "const": "advanceTime"
            },
            "blob": {
              "type": "string",
              "minLength": 1
            },
            "milliseconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "blob",
            "logicalVersion"
          ],
          "properties": {
            "action": {
              "const": "attemptResurrection"
            },
            "blob": {
              "type": "string",
              "minLength": 1
            },
            "logicalVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "replicaMutation": {
      "type": "object",
      "required": [
        "action",
        "blob",
        "replica"
      ],
      "properties": {
        "action": {
          "enum": [
            "tamperContent",
            "invalidateSignature",
            "useUntrustedSigningKey",
            "removeReplica"
          ]
        },
        "blob": {
          "type": "string",
          "minLength": 1
        },
        "replica": {
          "$ref": "#/$defs/replica"
        }
      },
      "additionalProperties": false
    },
    "fault": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FAULT-(NET|RING|PROC|COMMIT|RACE)-[0-9]{3}$"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "operation",
        "status"
      ],
      "properties": {
        "operation": {
          "enum": [
            "putBlob",
            "deleteBlob",
            "head",
            "getBlob",
            "observePreparedPublication"
          ]
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "bodyHex": {
          "type": "string",
          "pattern": "^[0-9a-f]*$"
        },
        "contentRange": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "collectionRun": {
      "type": "object",
      "required": [
        "atMs",
        "collectedVersions"
      ],
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "collectedVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": [
        "clientOutcome",
        "visibleBlob",
        "healthAfterOperations",
        "healthAfterReconciliation"
      ],
      "properties": {
        "clientOutcome": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "enum": [
                "success",
                "failure",
                "ambiguous",
                "failure-or-ambiguous"
              ]
            }
          },
          "additionalProperties": false
        },
        "visibleBlob": {
          "type": "object",
          "required": [
            "present",
            "mustNeverBePrepared"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "mustNeverBePrepared": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "healthAfterOperations": {
          "$ref": "#/$defs/health"
        },
        "healthAfterReconciliation": {
          "$ref": "#/$defs/health"
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/response"
          }
        },
        "currentLogicalVersion": {
          "type": "integer",
          "minimum": 1
        },
        "physicalContentVersions": {
          "$ref": "#/$defs/versionList"
        },
        "collectedVersions": {
          "$ref": "#/$defs/versionList"
        },
        "collectionRuns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collectionRun"
          }
        }
      },
      "additionalProperties": false
    },
    "health": {
      "enum": [
        "ABSENT",
        "HEALTHY",
        "DRIFTED",
        "MISSING",
        "TAMPERED",
        "QUARANTINED"
      ]
    },
    "versionList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
